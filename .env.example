# ShortGPT API Keys Configuration
# Copy this file to .env and fill in your API keys

# GEMINI API KEY (FREE - recommended as first choice)
# Get it from: https://makersuite.google.com/app/apikey
# Note: ShortGPT now prioritizes Gemini API over OpenAI
GEMINI_API_KEY=your_gemini_api_key_here

# OPENAI API KEY (fallback option)
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ELEVENLABS API KEY (optional - for high-quality voice synthesis)
# Get it from: https://elevenlabs.io/
# Note: EdgeTTS is used as a free alternative if not provided
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# PEXELS API KEY (FREE - for stock video footage)
# Get it from: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here
