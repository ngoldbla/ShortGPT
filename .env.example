# ShortGPT API Keys Configuration
# Copy this file to .env and fill in your API keys
#
# REQUIRED - At least ONE of these AI API keys:

# GEMINI API KEY (FREE - recommended as first choice)
# Get it from: https://makersuite.google.com/app/apikey
# Note: ShortGPT now prioritizes Gemini API over OpenAI
GEMINI_API_KEY=your_gemini_api_key_here

# OPENAI API KEY (fallback option if Gemini not provided)
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OPTIONAL - The app will work without these:

# ELEVENLABS API KEY (optional - for high-quality voice synthesis)
# Get it from: https://elevenlabs.io/
# Note: Free EdgeTTS will be used if not provided
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# PEXELS API KEY (optional but recommended - FREE for stock video footage)
# Get it from: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here
